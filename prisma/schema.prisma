datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String         @id @default(cuid())
  username     String         @unique
  email        String         @unique
  passwordHash String
  name         String?
  phone        String?
  role         String         @default("USER") // "USER" | "ADMIN" | "SUPERADMIN"
  invitations  Invitation[]
  payments     PaymentOrder[]
  subscription UserSubscription?
  messages     ContactMessage[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model EventCategory {
  id          String      @id @default(cuid())
  slug        String      @unique // "haldi", "wedding", "nikah", etc.
  name        String
  description String?
  iconSvg     String?
  sortOrder   Int         @default(0)
  isActive    Boolean     @default(true)
  templates   Template[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Template {
  id                 String         @id @default(cuid())
  slug               String         @unique
  name               String
  description        String?
  categoryId         String
  category           EventCategory  @relation(fields: [categoryId], references: [id])
  price              Float          @default(0.0)
  previewImageUrl    String
  
  // Experience & Archetype Classification
  archetype          String         // "soft_botanical" | "theatrical_curtain" | "minimal_editorial" | "haldi_scratch"
  experienceType     String         // "envelope" | "curtain" | "multi_scratch" | "scroll_story"
  
  // Visual Asset & Composition Manifests
  assetManifest      String         // JSON: TemplateAssetManifest (backgrounds, envelopes, seals, frames)
  visualIdentity     String         // JSON: Color tokens, materials, typography, depth
  openingConfig      String         // JSON: Initial opening scene rules
  revealNodesConfig  String?        // JSON: Array of RevealNodeDefinitions
  choreographyConfig String?        // JSON: ChoreographyStep array
  scrollStoryConfig  String?        // JSON: Scroll milestones and timeline events
  
  layoutConfig       String         // JSON: Slot layout & dynamic bindings
  fieldsSchema       String         // JSON: Dynamic form field definitions
  styleConstraints   String         // JSON: Bounded font scales & palettes
  
  supportedRevealModes String?      // JSON: Array of supported reveal modes e.g. ["fade", "scratch", "scroll"]
  supportedBgModes     String?      // JSON: Array of supported background modes
  
  isActive           Boolean        @default(true)
  isFeatured         Boolean        @default(false)
  invitations        Invitation[]
  compatibilities    AnimationCompatibility[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

model Animation {
  id               String         @id @default(cuid())
  slug             String         @unique
  name             String
  description      String?
  price            Float          @default(0.0)
  previewPosterUrl String
  pluginKey        String
  interactionType  String         // "tap", "swipe", "scratch", "audio_blow", "scroll", "video"
  videoUrl         String?
  soundEffectUrl   String?
  isActive         Boolean        @default(true)
  invitations      Invitation[]
  compatibilities  AnimationCompatibility[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model AnimationCompatibility {
  id          String     @id @default(cuid())
  templateId  String
  animationId String
  template    Template   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  animation   Animation  @relation(fields: [animationId], references: [id], onDelete: Cascade)

  @@unique([templateId, animationId])
}

model Background {
  id          String       @id @default(cuid())
  name        String
  previewUrl  String
  assetUrl    String
  theme       String       // "blush_warm", "royal_crimson", "sacred_emerald", "festive_haldi"
  price       Float        @default(0.0)
  isPremium   Boolean      @default(false)
  isActive    Boolean      @default(true)
  invitations Invitation[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model DurationTier {
  id          String       @id @default(cuid())
  days        Int          @unique // 15, 30, 45, 60
  name        String
  price       Float        @default(0.0)
  isDefault   Boolean      @default(false)
  isActive    Boolean      @default(true)
  invitations Invitation[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Invitation {
  id              String            @id @default(cuid())
  slug            String            @unique
  title           String
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId      String
  template        Template          @relation(fields: [templateId], references: [id])
  animationId     String
  animation       Animation         @relation(fields: [animationId], references: [id])
  backgroundId    String
  background      Background        @relation(fields: [backgroundId], references: [id])
  durationTierId  String
  durationTier    DurationTier      @relation(fields: [durationTierId], references: [id])
  
  eventData       String            // JSON: Host data values
  styleConfig     String            // JSON: Host styling values
  locationData    String?           // JSON: Address, coordinates, map link
  revealMode      String?           // The chosen reveal mode (e.g. "fade", "scratch")
  customImage     String?           // Custom image uploaded by user
  bgBlur          Int               @default(0) // Blur for background image
  
  calculatedPrice Float             @default(0.0)
  status          String            @default("DRAFT") // "DRAFT" | "PENDING_PAYMENT" | "ACTIVE" | "EXPIRED" | "ARCHIVED"
  activatedAt     DateTime?
  expiresAt       DateTime?
  viewCount       Int               @default(0)
  
  payments        PaymentOrder[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([slug])
  @@index([userId])
  @@index([status])
}

model PaymentOrder {
  id              String               @id @default(cuid())
  orderNumber     String               @unique
  invitationId    String
  invitation      Invitation           @relation(fields: [invitationId], references: [id])
  userId          String
  user            User                 @relation(fields: [userId], references: [id])
  amount          Float
  currency        String               @default("BDT")
  gateway         String               // "bkash", "nagad", "sslcommerz"
  status          String               @default("INITIAL") // "INITIAL" | "PENDING" | "SUCCESS" | "FAILED" | "REFUNDED"
  itemBreakdown   String               // JSON snapshot of component prices
  transactions    PaymentTransaction[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([orderNumber])
  @@index([userId])
}

model PaymentTransaction {
  id              String       @id @default(cuid())
  paymentOrderId  String
  paymentOrder    PaymentOrder @relation(fields: [paymentOrderId], references: [id], onDelete: Cascade)
  trxId           String?      @unique
  gatewayRef      String?
  rawResponse     String?
  status          String       @default("INITIAL") // "INITIAL" | "PENDING" | "SUCCESS" | "FAILED" | "REFUNDED"
  createdAt       DateTime     @default(now())
}

model UserSubscription {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planName        String   @default("FREE")
  maxFreeCards    Int      @default(1)
  maxRSVP         Int      @default(30)
  maxAnimations   Int      @default(5)
  isActive        Boolean  @default(true)
  expiresAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ContactMessage {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String?
  message     String
  status      String   @default("UNREAD") // "UNREAD" | "READ" | "REPLIED"
  adminReply  String?
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
